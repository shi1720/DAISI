{
  "datasets": [
    {
      "name": "closures_on_demo_date",
      "displayName": "Known closures \u00b7 28 September 2026",
      "query": "SELECT closure_date, closed_centres, food_stalls_closed\nFROM published_closure_calendar\nWHERE closure_date = DATE '2026-09-28'"
    },
    {
      "name": "evaluated_budget_comparison",
      "displayName": "Same-budget model comparison \u00b7 22 September 2026",
      "query": "SELECT budget AS daily_budget_sgd, 'Optimised proposal' AS strategy, weighted_benefit AS weighted_meal_benefit\nFROM published_evaluations\nWHERE evaluation_date = DATE '2026-09-22'\nUNION ALL\nSELECT budget AS daily_budget_sgd, 'Largest-demand-first baseline' AS strategy, baseline_weighted_benefit AS weighted_meal_benefit\nFROM published_evaluations\nWHERE evaluation_date = DATE '2026-09-22'\nORDER BY daily_budget_sgd, strategy"
    },
    {
      "name": "published_source_provenance",
      "displayName": "Source audit \u00b7 latest successful publication",
      "query": "SELECT source_key, source_fetched_at, coalesce(archived_reused_at, 'No reuse marker') AS reuse_status,\n       CASE WHEN mirror THEN 'Mirror' ELSE 'Official source' END AS source_route, sha256, source_url\nFROM published_bronze_sources\nORDER BY source_key"
    },
    {
      "name": "unresolved_interval_review",
      "displayName": "Unresolved closure intervals \u00b7 operator review queue",
      "query": "SELECT coalesce(c.name, q.centre_id) AS centre, q.kind AS closure_kind,\n       coalesce(q.source_start, '') AS reported_start, coalesce(q.source_end, '') AS reported_end,\n       q.reason, q.source_text\nFROM published_quarantine q\nLEFT JOIN published_centres c ON q.centre_id = c.id\nORDER BY q.reason, centre, q.kind, q.source_start"
    }
  ],
  "pages": [
    {
      "name": "hawkerbridge_evidence",
      "displayName": "Closure evidence & planning quality",
      "layout": [
        {
          "widget": {
            "name": "closed_centre_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "closures_on_demo_date",
                  "disaggregated": true,
                  "fields": [
                    {
                      "name": "closed_centres",
                      "expression": "`closed_centres`"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "Centres scheduled closed",
                "showDescription": true,
                "description": "28 September 2026 \u00b7 infrastructure count, not people without food. Latest successful publication."
              },
              "encodings": {
                "value": {
                  "fieldName": "closed_centres",
                  "displayName": "Scheduled closed centres"
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "same_budget_comparison",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "evaluated_budget_comparison",
                  "disaggregated": true,
                  "fields": [
                    {
                      "name": "daily_budget_sgd",
                      "expression": "`daily_budget_sgd`"
                    },
                    {
                      "name": "strategy",
                      "expression": "`strategy`"
                    },
                    {
                      "name": "weighted_meal_benefit",
                      "expression": "`weighted_meal_benefit`"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "frame": {
                "showTitle": true,
                "title": "Does the allocation improve on the baseline?",
                "showDescription": true,
                "description": "22 September 2026 \u00b7 800 m reach \u00b7 5% assumed uptake. Weighted meal benefit is modelled, not observed impact."
              },
              "encodings": {
                "x": {
                  "fieldName": "daily_budget_sgd",
                  "displayName": "Daily budget (S$)",
                  "scale": {
                    "type": "categorical"
                  },
                  "axis": {
                    "title": "Daily budget (S$)"
                  }
                },
                "y": {
                  "fieldName": "weighted_meal_benefit",
                  "displayName": "Weighted meal benefit",
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "Weighted meal benefit"
                  }
                },
                "color": {
                  "fieldName": "strategy",
                  "displayName": "Allocation strategy",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "label": {
                  "show": false
                }
              },
              "mark": {
                "colors": [
                  "#CA8A04",
                  "#167D73"
                ],
                "layout": "group"
              }
            }
          },
          "position": {
            "x": 2,
            "y": 0,
            "width": 4,
            "height": 3
          }
        },
