# Local single-process deployment; never commit secrets.
HAWKERBRIDGE_AUTH_MODE=local
HAWKERBRIDGE_STORAGE=local
HAWKERBRIDGE_BIND=127.0.0.1
PORT=8000
# For a hosted deployment behind HTTPS, set true and specify its exact origins.
HAWKERBRIDGE_SECURE_COOKIES=false
HAWKERBRIDGE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
# Databricks values belong in bundle variables / app resources, not this file.
# DATABRICKS_WAREHOUSE_ID=
# HAWKERBRIDGE_CATALOG=workspace
# HAWKERBRIDGE_SCHEMA=hawkerbridge

# Public Firebase mode uses managed runtime identity, never a service-account key.
# HAWKERBRIDGE_AUTH_MODE=firebase
# HAWKERBRIDGE_STORAGE=firestore
# HAWKERBRIDGE_FIREBASE_PROJECT=your-identity-project
# HAWKERBRIDGE_FIREBASE_API_KEY=your-public-firebase-web-api-key
# HAWKERBRIDGE_FIRESTORE_DATABASE=(default)
# HAWKERBRIDGE_SECURE_COOKIES=true
# HAWKERBRIDGE_ALLOWED_ORIGINS=https://your-site.web.app
# HAWKERBRIDGE_AUTH_ATTEMPTS_PER_5_MINUTES=120
# HAWKERBRIDGE_GUEST_SESSIONS_PER_HOUR=120
# HAWKERBRIDGE_PASSWORD_RESETS_PER_HOUR=30
